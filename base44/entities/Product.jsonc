{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "large_earrings",
        "small_earrings",
        "necklaces",
        "pulseras",
        "anillos"
      ]
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "out_of_stock",
        "limited"
      ],
      "default": "available"
    },
    "units_remaining": {
      "type": "number"
    },
    "inventory": {
      "type": "number",
      "default": 0
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "discount_percent": {
      "type": "number"
    },
    "discount_color_id": {
      "type": "string"
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "hex": {
            "type": "string"
          },
          "is_multicolor": {
            "type": "boolean",
            "default": false
          },
          "photo_indices": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "out_of_stock",
              "limited"
            ],
            "default": "available"
          },
          "units_remaining": {
            "type": "number"
          },
          "inventory": {
            "type": "number",
            "default": 0
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    }
  },
  "required": [
    "name",
    "price",
    "images",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}